# Copy to .env.local and fill in. Without Stripe keys the checkout button is
# disabled; the rest of the site works.

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# "payment" (one-time, default) or "subscription"
STRIPE_CHECKOUT_MODE=payment

# --- Supabase (the same project as wedding-saas) ---
# The webhook writes paid orders to the shared `orders` table.
NEXT_PUBLIC_SUPABASE_URL=
# Server only. Bypasses Row Level Security: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Links ---
# A live wedding-saas site to show on "See an example". Hidden when empty.
NEXT_PUBLIC_EXAMPLE_SITE_URL=
