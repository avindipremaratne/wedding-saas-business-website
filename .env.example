# Copy to .env.local and fill in. Nothing is required to see the site.

# --- Brand ---
# The business name shown in the header, footer and page titles. Leave empty
# to use "Vindora Invites".
NEXT_PUBLIC_BRAND_NAME=
# Shown in the footer when set.
NEXT_PUBLIC_CONTACT_EMAIL=
# A live wedding-saas site for the "View the live demo" buttons. Hidden when empty.
NEXT_PUBLIC_EXAMPLE_SITE_URL=

# --- Enquiry emails (Resend, the same account as wedding-saas) ---
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Enquiries <hello@yourbrand.com>".
# Until a domain is verified, use onboarding@resend.dev and send to your
# Resend sign-up address.
ENQUIRY_FROM_EMAIL=
# Your inbox, where new enquiries arrive.
ENQUIRY_TO_EMAIL=

# --- Supabase (the same project as wedding-saas) ---
# Enquiries are saved to the `enquiries` table.
NEXT_PUBLIC_SUPABASE_URL=
# Server only. Bypasses Row Level Security: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
